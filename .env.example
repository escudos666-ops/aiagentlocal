# Copy this file to .env and change the secrets before running.
# PowerShell: Copy-Item .env.example .env

# Core database
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=project_db

# Open WebUI admin and secret
WEBUI_SECRET_KEY=change-this-long-random-webui-secret
OPENWEBUI_ADMIN_EMAIL=admin@local
OPENWEBUI_ADMIN_PASSWORD=change-this-openwebui-password
OPENWEBUI_ADMIN_NAME=Admin
WEBUI_URL=http://127.0.0.1:3000

# Local model defaults
TASK_MODEL=agentics-assistant:latest
TASK_MODEL_EXTERNAL=docker.io/ai/llama3.2:latest
DEFAULT_MODELS=agentics-assistant:latest
DEFAULT_PINNED_MODELS=agentics-assistant:latest,llama3.1:latest,qwen2.5-coder:7b,llama3.2:3b,docker.io/ai/llama3.2:latest
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
AGENTICS_DEFAULT_AGENT_MODEL=agentics-assistant:latest

# Ollama performance. RTX 4070 Laptop 8 GB: keep these conservative.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1

# Optional Docker Model Runner / OpenAI-compatible endpoint.
OPENAI_API_BASE_URL=http://host.docker.internal:12434/engines/llama.cpp/v1
OPENAI_API_BASE_URLS=http://host.docker.internal:12434/engines/llama.cpp/v1
OPENAI_API_KEY=dmr-local
OPENAI_API_KEYS=dmr-local

# CORS
CORS_ALLOW_ORIGIN=http://127.0.0.1:3000;http://localhost:3000;http://127.0.0.1:8787;http://localhost:8787;http://127.0.0.1:8088;http://localhost:8088;http://ai.localhost;http://n8n.localhost;http://graphql.localhost;https://mjhee-personal-assistant.admetec-nl-8738.chatgpt-team.site
AGENTICS_TOOLS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:8088,http://localhost:8088,https://mjhee-personal-assistant.admetec-nl-8738.chatgpt-team.site

# n8n
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://127.0.0.1:5678/

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-this-minio-password

# Open Terminal
OPEN_TERMINAL_API_KEY=change-this-terminal-key

# Optional integrations
WAHA_API_KEY=
GRAFANA_INTERNAL_URL=
PROMETHEUS_INTERNAL_URL=
LOKI_INTERNAL_URL=
