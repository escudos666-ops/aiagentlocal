# Copy to .env.openclaw and replace secrets before starting the overlay.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_TZ=Europe/Amsterdam

# Open WebUI sees OpenClaw as an OpenAI-compatible backend once enabled.
# Keep these aligned by position if you add more providers later.
OPENWEBUI_OPENAI_API_BASE_URLS=http://openclaw-gateway:18789/v1
OPENWEBUI_OPENAI_API_KEYS=replace-with-the-same-token-as-OPENCLAW_GATEWAY_TOKEN

# The MCP bridge sends chat requests to this agent target by default.
OPENCLAW_DEFAULT_MODEL=openclaw/default
